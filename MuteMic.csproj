<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kuro MuteMic</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyTitle>Kuro Mute &amp; Force Mic</AssemblyTitle>
    <Product>Kuro Mute &amp; Force Mic</Product>
    <Description>Mute your microphone with a fully customizable hotkey and overlay. Force Windows to keep the input device you actually picked, so your apps stop losing their audio settings every time Windows switches it behind your back.</Description>
    <Company>Kurohiko-id</Company>
    <Copyright>Copyright © Kurohiko-id</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="kuro-mute-mic-logo.png" />
    <Resource Include="kuro-mute-on.png" />
    <Resource Include="kuro-mute-off.png" />
  </ItemGroup>

  <!-- Program.cs owns Main; keep App.xaml as a plain resource dictionary host, not an auto-generated entry point. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

</Project>