<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Kuro MuteMic</AssemblyName>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <AssemblyTitle>Kuro Mute &amp; Force Mic</AssemblyTitle>
    <Product>Kuro Mute &amp; Force Mic</Product>
    <Description>Mute your microphone with a fully customizable hotkey and overlay. Force Windows to keep the input device you actually picked, so your apps stop losing their audio settings every time Windows switches it behind your back.</Description>
    <Company>Kurohiko-id</Company>
    <Copyright>Copyright © Kurohiko-id</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AudioSwitcher.AudioApi.CoreAudio" Version="3.0.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="kuro-mute-mic-logo.png" />
  </ItemGroup>

  <!-- Same app.ico also embedded as a plain resource (not a WPF pack:// resource) so
       TrayApp can load it for the tray icon with no dependency on
       System.Windows.Application ever being constructed. -->
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!-- Program.cs owns Main; keep App.xaml as a plain resource dictionary host, not an auto-generated entry point. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <!-- Lite-edition-only sources (built by MuteMic.Lite.csproj instead); excluded here
       since SDK-style projects glob all *.cs in the folder by default. -->
  <ItemGroup>
    <Compile Remove="Program.Lite.cs" />
    <Compile Remove="TrayApp.Lite.cs" />
    <Compile Remove="SettingsFormLite.cs" />
  </ItemGroup>

</Project>